  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#c7d5c8"
          }
        },
        "update": {
          "path": {
            "signal": "'M'+(lx+10)+','+datum.sy+' C'+(width*0.48)+','+datum.sy+' '+(width*0.52)+','+datum.ty+' '+rx+','+datum.ty+' L'+rx+','+(datum.ty+datum.h)+' C'+(width*0.52)+','+(datum.ty+datum.h)+' '+(width*0.48)+','+(datum.sy+datum.h)+' '+(lx+10)+','+(datum.sy+datum.h)+' Z'"
          },
          "tooltip": {
            "signal": "{'HbA1c classification':datum.a,'FPG classification':datum.b,'Eligible adults (%)':datum.percent,'Reliability':datum.caution}"
          }
        },
        "hover": {
          "fill": {
            "value": "#17665a"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side == 'left' ? lx : rx"
          },
          "width": {
            "value": 10
          },
          "y": {
            "field": "y"
          },
          "y2": {
            "field": "y2"
          },
          "fill": {
            "value": "#243d37"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side == 'left' ? lx-8 : rx+18"
          },
          "y": {
            "signal": "(datum.y+datum.y2)/2"
          },
          "text": {
            "field": "label"
          },
          "align": {
            "signal": "datum.side == 'left' ? 'right' : 'left'"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#243d37"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "lx"
          },
          "y": {
            "value": -12
          },
          "text": {
            "value": "HbA1c test"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#243d37"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "rx"
          },
          "y": {
            "value": -12
          },
          "text": {
            "value": "Fasting glucose test"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#243d37"
          }
        }
      }
    }
  ]
