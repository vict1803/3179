{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 660,
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 12,
  "data": {
    "url": "data/processed/age_sex.csv",
    "format": {
      "type": "csv"
    }
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#45564e",
      "titleColor": "#45564e",
      "domain": false,
      "tickColor": "#c7d0c8",
      "gridColor": "#e1e6df",
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#45564e",
      "titleColor": "#45564e",
      "symbolStrokeWidth": 3
    },
    "title": {
      "font": "Arial",
      "fontSize": 19,
      "fontWeight": "normal",
      "anchor": "start",
      "offset": 18,
      "color": "#243d37"
    }
  },
  "params": [
    {
      "name": "sexPick",
      "value": "All"
    }
  ],
  "transform": [
    {
      "filter": "sexPick == 'All' || datum.sex == sexPick"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#f5f4ee",
    "strokeWidth": 5,
    "cornerRadius": 5
  },
  "encoding": {
    "x": {
      "field": "sex",
      "type": "nominal",
      "title": null,
      "sort": [
        "Males",
        "Females"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": null,
      "sort": [
        "18–44",
        "45–54",
        "55–64",
        "65–74",
        "75+"
      ]
    },
    "color": {
      "field": "prevalence_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          20
        ],
        "range": [
          "#e9efdf",
          "#17665a"
        ]
      },
      "legend": {
        "title": "Prevalence (%)",
        "orient": "bottom",
        "gradientLength": 200
      }
    },
    "tooltip": [
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Age"
      },
      {
        "field": "sex",
        "type": "nominal",
        "title": "Sex"
      },
      {
        "field": "prevalence_pct",
        "type": "quantitative",
        "title": "Prevalence (%)",
        "format": ".1f"
      },
      {
        "field": "caution",
        "type": "nominal",
        "title": "Reliability note"
      },
      {
        "field": "ci_low",
        "type": "quantitative",
        "title": "95% interval: low",
        "format": ".1f"
      },
      {
        "field": "ci_high",
        "type": "quantitative",
        "title": "95% interval: high",
        "format": ".1f"
      }
    ]
  }
}
